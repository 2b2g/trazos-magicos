{
  "name": "garabati",
  "private": true,
  "version": "0.10.0",
  "description": "Garabati — videojuego web de grafomotricidad, preescritura y escritura inicial para niños de 3 a 6 años",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "voice:lines": "node scripts/generate-voice.mjs --lines",
    "voice:generate": "node scripts/generate-voice.mjs",
    "voice:audition": "node scripts/generate-voice.mjs --audition"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-legacy": "^5.4.0",
    "terser": "^5.36.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
